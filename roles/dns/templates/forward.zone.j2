; Managed by Ansible: forward zone mapping host names to IPv4 addresses.
$TTL {{ dns_zone_negative_ttl }}
@ IN SOA {{ dns_primary_host }}.{{ domain }}. admin.{{ domain }}. (
    {{ dns_zone_serial }}
    {{ dns_zone_refresh }}
    {{ dns_zone_retry }}
    {{ dns_zone_expire }}
    {{ dns_zone_negative_ttl }} )

@ IN NS {{ dns_primary_host }}.{{ domain }}.
{% if dns_secondary_enabled %}
@ IN NS {{ dns_secondary_host }}.{{ domain }}.
{% endif %}

{{ dns_primary_host }} IN A {{ hostvars[dns_primary_host].ansible_host }}
{% if dns_secondary_enabled %}
{{ dns_secondary_host }} IN A {{ hostvars[dns_secondary_host].ansible_host }}
{% endif %}
{% for record in dns_zone_records %}
{{ record.name }} IN A {{ record.address }}
{% endfor %}
