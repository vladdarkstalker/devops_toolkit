# Managed by Ansible: HTTP virtual host publishing PXE content.
server {
    listen {{ nginx_listen_port }} default_server;
    listen [::]:{{ nginx_listen_port }} default_server;

    server_name {{ nginx_server_name }};
    root {{ nginx_root }};

    location / {
        autoindex on;
        try_files $uri $uri/ =404;
    }
}
