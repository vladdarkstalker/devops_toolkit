# Managed by Ansible: ISC DHCP configuration for BIOS and UEFI PXE clients.
# Network values are supplied by the DHCP role defaults or shared PXE vars file.

allow booting;
allow bootp;

option architecture-type code 93 = unsigned integer 16;

subnet {{ dhcp_subnet }} netmask {{ dhcp_netmask }} {
  range {{ dhcp_range_start }} {{ dhcp_range_end }};
  option broadcast-address {{ dhcp_broadcast_address }};
  option routers {{ dhcp_gateway }};
  option domain-name-servers {{ dhcp_dns_servers | join(', ') }};
  next-server {{ dhcp_tftp_server }};

  class "pxeclients" {
    match if substring(option vendor-class-identifier, 0, 9) = "PXEClient";

    if option architecture-type = 00:00 {
      filename "BIOS/pxelinux.0";
    } elsif option architecture-type = 00:06 {
      filename "EFIia32/syslinux.efi";
    } elsif option architecture-type = 00:07 {
      filename "EFIx64/syslinux.efi";
    } elsif option architecture-type = 00:09 {
      filename "EFIx64/syslinux.efi";
    } else {
      filename "BIOS/pxelinux.0";
    }
  }
}
